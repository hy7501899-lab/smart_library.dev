GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
PORT=10000

# Allow the pages to work from Live Server / a file while Flask runs on its own port.
# Set to false when you deploy.
ALLOW_LOCAL_FRONTEND=true
# If the front end is hosted on another domain, list it here (comma separated)
# CORS_ORIGINS=https://your-frontend.example.com
